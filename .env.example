# XSite environment variables — copy to .env (root, ignored by git) and fill in.
# Never commit real values. See docs/DEPLOYMENT.md, docs/AUTHENTICATION.md,
# docs/PERSISTENCE.md, docs/PAYMENTS.md for what each section is for.

# --- Application -------------------------------------------------------------
NODE_ENV=development
# Public URL of this deployment. Used for Clerk redirects and payment
# return/webhook URLs. Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to 1 to force demo/simulated behavior even outside development.
# Never set this in a real production deployment.
DEMO_MODE=1

# --- Database (packages/db, PostgreSQL via Prisma) ---------------------------
# Local dev default matches `docs/PERSISTENCE.md`'s setup instructions.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xsite_dev"

# --- Authentication (Clerk) — see docs/AUTHENTICATION.md ---------------------
# Create a Clerk application at https://dashboard.clerk.com, then copy these
# from your application's API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From your Clerk application's Webhooks page after adding an endpoint
# pointing at /api/webhooks/clerk on this deployment.
CLERK_WEBHOOK_SECRET=

# --- Payments — see docs/PAYMENTS.md ------------------------------------------
# Which provider adapter is active. 'mock' runs the sandbox-safe adapter that
# never touches a real payment network — safe for local dev and CI.
PAYMENT_PROVIDER=mock
# When true, the selected provider's adapter runs in its sandbox/test mode.
# Leave true until merchant production credentials are activated.
PAYMENT_SANDBOX_MODE=true

# PayTabs (selected first provider — see docs/PAYMENTS.md for why).
# Sandbox credentials come from https://dashboard.paytabs.com (sandbox profile).
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
# Region code selects the API host (secure-<region>.paytabs.com). Jordan is
# HorizonX's home market; change if the merchant account is registered
# under a different PayTabs region.
PAYTABS_REGION=jordan
