# Server-only. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Internal MVP access. Use a strong unique password and 32+ random-character signing secret.
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional AI provider. The deterministic solution engine works without it.
# OPENAI_API_KEY=replace-me
