# Server-only PostgreSQL on the XSite VPS. NEVER prefix with NEXT_PUBLIC_.
# Recommended production host is 127.0.0.1 so PostgreSQL is not internet-exposed.
DATABASE_URL=postgresql://xsite_app:replace-me@127.0.0.1:5432/xsite
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Internal MVP access. Use a strong unique password and 32+ random-character signing secret.
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional AI provider. Leave unset: deterministic solution/scoring runs at zero API cost.
# OPENAI_API_KEY=replace-me
